#### rcbin
# every rc script of /rc/bin as a function, printed back by whatis
for(f in /rc/bin/* /rc/lib/rcmain){
	l=`{sed 1q $f}
	if(~ $f /rc/lib/rcmain || ~ $l '#!/bin/rc'*){
		echo '=== '^$f
		{echo 'fn x {'; cat $f; echo; echo '}'} >def
