#!/bin/rc
# planZ's Zig programs beside the stock 9front ones.  On the USB stick
# this is zig/run, beside zig/bin/*; `zig build test-zuser` fetches it
# into a booted 9front with the programs and runs it the same way.
#
# The programs are copied to /tmp/zig and made executable there (the
# FAT file server gives no execute permission).  Then each runs beside
# the stock program of the same name with the same arguments, and the
# output must be the same byte for byte; for the commands that change
# files, the same steps are run in two directories, one with each set
# of programs, and the resulting trees compared.  libctest checks the
# rest of the library.  The report is also kept in /tmp/zig.txt, and
# its last line is "zig: all the same as stock, libctest ok" or says
# what failed.
#
# usage: rc run [bindir]	(default /n/esp/zig/bin)

rfork e
src=/n/esp/zig/bin
if(! ~ $#* 0)
	src=$1
z=/tmp/zig
mkdir -p $z
for(f in $src/*){
	b=`{basename $f}
	cp $f $z/$b && chmod +x $z/$b
}

fn t {
	if(cmp -s /tmp/zig.a /tmp/zig.b)
		echo same $1 `{wc -c </tmp/zig.a} bytes
	if not {
		echo DIFF $1 '(< planZ, > stock)'
		diff /tmp/zig.a /tmp/zig.b | sed 20q
		nbad=($nbad $1)
	}
}

# the exit status without "name pid: " in front
fn s {
	echo status `{echo $status | sed 's/^[^:]*: //'}
}

# the files under $1: mode, length and name of each
fn tree {
	@{
		cd $1
		for(f in `{du -a . | awk '$2 != "." {print $2}' | sort})
			ls -ld $f | awk '{print $1, $6, $10}'
	}
}

# what the file commands are tested with: $1 is /tmp/zig/ for planZ's
# programs and empty for the stock ones
fn ops {
	p=$1
	$p^mkdir -p a/b/c x; s
	$p^mkdir -m 750 m; s
	$p^mkdir a; s
	$p^touch t1 a/t2; s
	$p^touch -c nothere; s
	$p^chmod 640 t1; s
	$p^chmod a+x a/t2; s
	$p^chmod go-w m; s
	$p^chmod q+x t1; s
	$p^cp /lib/namespace ns; s
	$p^cp ns t1 x; s
	$p^cp -x /lib/namespace nsx; s
	$p^cp nothere y; s
	$p^mv ns ns2; s
	$p^mv t1 x/t1b; s
	$p^mv a/t2 .; s
	$p^mv nothere y; s
	$p^rm m; s
	$p^rm -r a/b; s
	$p^rm nothere; s
	$p^rm -f nothere; s
	$p^cmp ns2 /lib/namespace; s
	{echo one; echo two} | $p^tee -a log x/log >tee.out; s
	{echo three} | $p^tee -a log; s
	$p^split -n 20 /lib/namespace; s
	$p^split -f pre -l 50 /lib/namespace; s
	$p^split -f sp -n 7 /lib/ndb/common; s
	# from standard input: the first output file closes it (as the C does)
	cat /lib/namespace | $p^split -f in -n 30; s
	$p^split /nope; s
	$p^split -f re -e '^#' /lib/namespace; s
	$p^split -f rx -x -e 'bind' /lib/namespace; s
	$p^split -e '^(mount|bind) ' -s .sfx /lib/namespace; s
	$p^split -i -e '^(BIND|MOUNT) -(.)' -s .i /lib/namespace; s
	$p^split -e '(' /lib/namespace; s
	$p^split -e '[a-' /lib/namespace; s
	$p^sed -n 'w sw1' /lib/namespace; s
	$p^sed -n '/bind/w sw2' /lib/namespace; s
	$p^sed 's/mount/M/w sw3' /lib/namespace >/dev/null; s
	$p^sed -n '/^#/w sw2' /lib/namespace; s
	$p^sed -n '1,3w sw4
5w sw4' /lib/namespace; s
}

# Each of these runs a command's cases with the programs $1 names
# (/tmp/zig/ or the stock ones); checks compares the two outputs.
fn basenames {
	p=$1
	$p^basename /a/b/c.c .c; $p^basename -d /a/b/c; $p^basename x
	$p^basename -d x; $p^basename /a/b/; $p^basename c.c c.c; $p^basename; s
}

fn cleannames {
	p=$1
	# '' last: the C cleans names in place in argv, and cleaning ''
	# writes ".\0" over the first byte of the argument after it
	$p^cleanname /a/../b//c/. x/./y/.. ../../a /.. ''
	$p^cleanname -d /usr/glenda ../x lib/./y /abs ''
	$p^cleanname; s
}

fn sleeps {
	p=$1
	$p^sleep 0.25; s; $p^sleep 1.5; s; $p^sleep 0; s
}

fn uniqs {
	p=$1
	{echo a; echo a; echo b; echo c; echo c; echo c; echo 'x  1 q'; echo 'y  1 q'; echo 'y  1 q'; echo -n last} >/tmp/zig.u
	$p^uniq </tmp/zig.u; $p^uniq -u /tmp/zig.u; $p^uniq -d /tmp/zig.u
	$p^uniq -c /tmp/zig.u; $p^uniq -1 /tmp/zig.u; $p^uniq +1 /tmp/zig.u
	$p^uniq -s /tmp/zig.u
	rm -f /tmp/zig.u
}

fn cmps {
	p=$1
	$p^cmp /lib/namespace /lib/namespace; s
	$p^cmp /lib/namespace /lib/namespace.ftp; s
	$p^cmp -L /lib/namespace /lib/namespace.ftp; s
	$p^cmp -l /lib/namespace /lib/namespace.ftp | sed 6q
	$p^cmp -s /lib/namespace /lib/namespace.ftp; s
	$p^cmp /lib/namespace /lib/namespace 10 10; s
	$p^cmp /lib/namespace /lib/namespace 10; s
	$p^cmp /lib/namespace /dev/null; s
	$p^cmp /lib/namespace; s
}

fn tails {
	p=$1
	$p^tail /lib/namespace; $p^tail -n 3 /lib/namespace; $p^tail +5 /lib/namespace
	$p^tail -c 20 /lib/namespace; $p^tail +20c /lib/namespace; $p^tail -r /lib/namespace
	$p^tail -3r /lib/namespace; cat /lib/namespace | $p^tail -2
	cat /lib/namespace | $p^tail +30; cat /lib/namespace | $p^tail -r
	cat /lib/namespace | $p^tail -c 7; $p^tail -n; s
}

# the inputs the commands below read; made once, used by both sides
fn inputs {
	echo 'héllo wörld ☺ 日本語 and plain ascii text' >/tmp/zig.utf
	echo 'tab	here	cr and ☺☺☺☺ smileys' >>/tmp/zig.utf
	ls /bin | sed 60q >/tmp/zig.c1
	ls /bin | sed -n '30,90p' >/tmp/zig.c2
	{echo 0123456789abcdef; echo 0123456789abcdef; echo 0123456789abcdef; echo -n tail} >/tmp/zig.x
	mkdir -p /tmp/zig.qd/sub
	touch '/tmp/zig.qd/a b' '/tmp/zig.qd/x$y' '/tmp/zig.qd/it''s' /tmp/zig.qd/sub/plain
	cp /lib/namespace /tmp/zig.qd/sub/ns
	# for grep: lines around 16K and 32K long, no final newline, an
	# empty file, pattern files, and a class of 99 and of 100 entries
	awk 'BEGIN{s=""; for(i=0;i<1000;i++) s = s "0123456789abcdef"
		print substr(s,1,16000) "bind"; print "bind" substr(s,1,16380); print "short bind"
		print "x" s s "bind end"; print s s s "tail bind"; print "last"}' >/tmp/zig.gl
	echo -n 'first
last bind' >/tmp/zig.gn
	touch /tmp/zig.ge
	echo 'bind
mount

*a.b' >/tmp/zig.gp
	echo 'a.b
axb
a*b
[x] and ^ $
BIND Mount' >/tmp/zig.gx
	awk 'BEGIN{s=""; for(i=0;i<99;i++) s = s "a"; print "[" s "]"; print "[" s "b]"}' >/tmp/zig.gc
}

fn mtimes {
	p=$1
	$p^mtime /lib/namespace /lib/ndb /nope; s
	$p^mtime; s
}

fn stringss {
	p=$1
	$p^strings /amd64/bin/rc | sed 60q
	$p^strings -m 3 /amd64/bin/echo
	$p^strings /tmp/zig.x /amd64/bin/echo | sed 30q
	$p^strings -m 4 /tmp/zig.utf
	$p^strings -m 4 </tmp/zig.utf
	$p^strings /nope; s
	$p^strings -m 0; s
}

fn freqs {
	p=$1
	$p^freq /lib/namespace
	$p^freq -c /amd64/bin/echo
	$p^freq -r /tmp/zig.utf
	$p^freq -rcx /tmp/zig.utf
	$p^freq -dx </lib/namespace
	$p^freq -o /nope /tmp/zig.x; s
	$p^freq -z; s
}

fn comms {
	p=$1
	c1=/tmp/zig.c1; c2=/tmp/zig.c2
	$p^comm $c1 $c2; $p^comm -1 $c1 $c2; $p^comm -2 $c1 $c2
	$p^comm -3 $c1 $c2; $p^comm -12 $c1 $c2; $p^comm -21 $c1 $c2
	$p^comm -13 $c1 $c2; $p^comm -23 $c1 $c2; $p^comm -123 $c1 $c2
	$p^comm - $c2 <$c1; $p^comm $c2 $c1; $p^comm $c1 $c1
	$p^comm $c1 /dev/null; $p^comm /dev/null $c2
	$p^comm $c1; s
	$p^comm $c1 /nope; s
}

fn reads {
	p=$1
	$p^read /lib/namespace; $p^read -n 3 /lib/namespace
	$p^read -m /lib/namespace /tmp/zig.x
	$p^read -c 50 /lib/namespace; echo
	$p^read -r 10 /tmp/zig.utf; echo
	$p^read -r 1000 /tmp/zig.utf
	# one line at a time from the same input, as rc scripts use it
	{$p^read; $p^read; $p^read -c 5; echo} </lib/namespace
	$p^read </dev/null; s
	$p^read /nope; s
	$p^read -c; s
}

fn unicodes {
	p=$1
	$p^unicode 41-4f 3b1-3c9; s
	$p^unicode 263a 41; $p^unicode -t 48 69 21; echo
	$p^unicode -n 'héllo ☺'; $p^unicode zz
	$p^unicode d800 10ffff | xd -c
	$p^unicode 110000; s
	$p^unicode 1-; s
	$p^unicode 50-40; s
	$p^unicode 4g; s
	$p^unicode; s
}

fn trs {
	p=$1
	f=/tmp/zig.utf
	$p^tr a-z A-Z <$f; $p^tr -d aeiou <$f; $p^tr -s l <$f
	$p^tr -c 'a-z\n' X <$f; $p^tr -cd 'a-z\n' <$f; $p^tr -cs 'a-z' '\n' <$f
	$p^tr -ds l o <$f; $p^tr '\x41-\x43' xyz </lib/namespace | sed 5q
	$p^tr '\101\102' 'qr' </lib/namespace | sed 5q; $p^tr 'éö☺' 'eo:' <$f
	$p^tr 'a-z' 'b' <$f; $p^tr '\t' '_' <$f
	$p^tr a; s
	$p^tr -d; s
	$p^tr aa xy <$f; s
	$p^tr z-a q <$f; s
}

fn xds {
	p=$1
	x=/tmp/zig.x
	$p^xd $x; $p^xd -c $x; $p^xd -b -c $x; $p^xd -1x -2o -4d -8x $x
	$p^xd -s -2x -8o $x; $p^xd -ad -1o $x; $p^xd -ao -c -4x $x
	$p^xd -r $x; $p^xd -r /tmp/zig.x /tmp/zig.utf
	$p^xd -u <$x; $p^xd /amd64/bin/echo | sed 20q
	$p^xd -c /amd64/bin/echo | sed 10q
	$p^xd </dev/null
	$p^xd /nope; s
	$p^xd -q $x; s
	$p^xd -cx $x; s
	$p^xd -x -x -x -x -x -x -x -x -x -x $x; s
}

fn dus {
	p=$1
	$p^du /lib/ndb; $p^du -a /lib/ndb; $p^du -s /lib
	$p^du -n /lib/ndb; $p^du -q /lib/ndb; $p^du -t /lib/ndb
	$p^du -tu /lib/ndb; $p^du -b 4k /lib/ndb; $p^du -b 3 -a /lib/ndb
	$p^du -p M /lib; $p^du -p k -a /lib/ndb
	$p^du -a /tmp/zig.qd; $p^du -an /tmp/zig.qd
	$p^du -r /lib/ndb; s
	$p^du /nope; s
	$p^du -f /nope; s
	$p^du -p q /lib; s
	$p^du -e /lib/ndb; $p^du -h /lib; $p^du -h -a /lib/ndb; $p^du -e -s /lib
	$p^du -h -n /lib/ndb; $p^du -e -p M /lib
}

fn seqs {
	p=$1
	$p^seq 5; $p^seq 2 10; $p^seq 1 0.5 4; $p^seq -w 8 12; $p^seq -w 0.5 0.25 2
	$p^seq 10 -3 1; $p^seq -f '%5.2f' 1 3; $p^seq -f 'x%gy' 1 3; $p^seq -f '%e' 0.1 0.1 0.5
	$p^seq -5 5; $p^seq -w -3 3; $p^seq 0 0; $p^seq 0.1 0.1 1; $p^seq -w 99995 100000
	$p^seq 1e6 1e6; $p^seq 1 1e20 1e21; $p^seq -w 1 .1 1.3; $p^seq -f '%.0f %%' 1 2
	$p^seq 1 0 5; s
	$p^seq; s
	$p^seq 1 2 3 4; s
}

fn factors {
	p=$1
	$p^factor 1 2 12 97 1001 123456789 600851475143 9007199254740991 1.5
	$p^factor 4294967291 4294967296 999999999989 0
	{echo 360; echo 1e3; echo 0; echo 5} | $p^factor
	echo -n 77 | $p^factor
}

fn primess {
	p=$1
	$p^primes 1 100; $p^primes 230 300; $p^primes 0 10; $p^primes 1000000 1000200
	$p^primes 9007199254740000 9007199254740992; $p^primes 100 50; s
	echo 990 | $p^primes >[2=1] | sed 3q
	$p^primes 1 1e17; s
	$p^primes -1 5; s
	$p^primes 1 2 3; s
}

fn seds {
	p=$1
	n=/lib/namespace
	u=/tmp/zig.utf
	$p^sed 5q $n; $p^sed -n '3,7p' $n; $p^sed '/^#/d' $n
	$p^sed -n '/bind/,/mount/p' $n; $p^sed -n '/^mount/,$p' $n; $p^sed -n '4,/bind/p' $n
	$p^sed 's/bind/BIND/' $n; $p^sed 's/a/A/g' $n; $p^sed 's/(b)(i)nd/\2\1/g' $n
	$p^sed 's/x*/-/g' $u; $p^sed 's/$/ END/' $u; $p^sed 's/^/> /' $u
	$p^sed -n '$p' $n; $p^sed -n '$=' $n /tmp/zig.x; $p^sed '=' $u; $p^sed '2,4!d' $n
	$p^sed 'y/abcé/xyzE/' $u; $p^sed -n l $u; $p^sed -n l /tmp/zig.x
	$p^sed 'n;d' $n; $p^sed 'N;P;D' $n | sed 8q; $p^sed '$!N;s/\n/ | /' $n
	$p^sed G $u; $p^sed '1!G;h;$!d' $n; $p^sed ':a;N;$!ba;s/\n/,/g' $u
	$p^sed '/bind/{s/b/B/;p;}' $n; $p^sed -n '/mount/!{/bind/p;}' $n
	$p^sed '2i\
inserted line\
and another' $u
	$p^sed '1a\
appended' $u; $p^sed '1c\
changed' $u; $p^sed '/bind/,/mount/c\
range' $n; $p^sed 'c\
all' $u; $p^sed '$a\
	END' $u
	$p^sed -g 's/a/b/' $u; $p^sed 's/(.)(.)/\2\1/' $u; $p^sed 's/bind/&&/' $n
	$p^sed 's/\//|/g' $n; $p^sed 's,/,|,g' $n; $p^sed 's/é/e/g;s/ö/o/' $u
	$p^sed 's/b/X/;ta;s/$/ no/;b;:a;s/$/ yes/' $n
	$p^sed -n 's/bind/B/p' $n; $p^sed -n 's/bind/B/P' $n; $p^sed 's/[aeiou]//gp' $u
	$p^sed 'h;s/./x/g;G;x' $u; $p^sed -n 'H;${x;p;}' $u
	$p^sed '3r /tmp/zig.x' $u; $p^sed 'r /nope' $u; $p^sed '1w ' $u
	$p^sed -e 's/a/1/' -e 's/b/2/' $u; $p^sed -n -e '/bind/=' $n
	cat $n | $p^sed 3q; cat $u | $p^sed -n '$='
	echo 's/m/M/g
/^#/d
3q' >/tmp/zig.sed; $p^sed -f /tmp/zig.sed $n
	echo 'a\
x' >/tmp/zig.sed; $p^sed -f /tmp/zig.sed $u; rm -f /tmp/zig.sed
	$p^sed; s
	$p^sed -q; s
	$p^sed k $u; s
	$p^sed 's/a/b' $u; s
	$p^sed '/a' $u; s
	$p^sed 's/(/x/' $u; s
	$p^sed 0p $u; s
	$p^sed 'b nolabel' $u; s
	$p^sed ':a;:a' $u; s
	$p^sed '{p' $u; s
	$p^sed 'p}' $u; s
	$p^sed 'y/abc/xy/' $u; s
	$p^sed -e; s
	$p^sed -f /nope $u; s
	$p^sed p /nope; s
	$p^sed ':toolongname' $u; s
	$p^sed 's/a/\1/' $u; s
	$p^sed '1,2=' $u; s
	$p^sed 'q;p' $u; s
	$p^sed '//p' $u; s
	$p^sed 's/a/b/x' $u; s
}

fn greps {
	p=$1
	n=/lib/namespace; u=/tmp/zig.utf; x=/tmp/zig.gx
	$p^grep bind $n; s; $p^grep -n mount $n; $p^grep -c '^#' $n; s
	$p^grep -v '^#' $n; $p^grep -vc bind $n; $p^grep -i BIND $n $x
	$p^grep -l bind $n $u /dev/null; s; $p^grep -L bind $n $u /dev/null; s
	$p^grep -h bind $n /dev/null; $p^grep bind $n /dev/null; $p^grep -cn bind $n $u /dev/null
	$p^grep -s bind $n; s; $p^grep -s zzzz $n; s; $p^grep zzzz $n; s
	$p^grep -b -n bind $n; $p^grep -nv x $u; $p^grep -lv bind $n $x; $p^grep -cv . $n
	$p^grep -e bind -e mount $n; $p^grep 'bind
mount' $n; $p^grep -e 'bind
' -n $n; $p^grep -- -c $n /dev/null; s
	$p^grep 'b(i|a)nd' $n; $p^grep 'mo+u?nt' $n; $p^grep '^[a-c]' $n; $p^grep '[^a-z #/]' $n
	$p^grep 'n$' $n; $p^grep '^$' $n; $p^grep -c '' $n; s; $p^grep '(a|e|i|o|u|y|w|n)(d|t)$' $n
	$p^grep 'a|b|c|d|e|f|g|h' $x; $p^grep -n '[x-z]|[0-9]|(bin|mou)' $n; $p^grep '.*' $x
	$p^grep '[☺日]' $u; $p^grep '[^ -~]' $u; $p^grep -c '.' $u; $p^grep '[é-ö]' $u
	$p^grep 'h.llo w.rld' $u; $p^grep -i 'HÉLLO' $u; $p^grep -i 'h[A-Z]llo' $u; $p^grep '[^	a-z]' $u
	$p^grep '*a.b' $x; $p^grep '**' $x; $p^grep '*[x]' $x; $p^grep 'a\.b' $x; $p^grep '\[' $x
	$p^grep 'a\*b' $x; $p^grep '[\]]' $x; $p^grep '[a-]' $x; $p^grep 'x^' $x
	$p^grep '^^' $x; $p^grep '[$]' $x; $p^grep -i 'bind mount' $x; $p^grep -i '[a-c]IND' $x
	cat $n | $p^grep bind; cat $x | $p^grep -c a; $p^grep -n x </dev/null; s
	$p^grep -f /tmp/zig.gp $n $x; $p^grep -e x -f /tmp/zig.gp $n $x; $p^grep -nf /tmp/zig.gp -i $x
	$p^grep -f /tmp/zig.gc $x; s; $p^grep -f /tmp/zig.gp -e x $n; s
	$p^grep bind /tmp/zig.gl; $p^grep -n bind /tmp/zig.gl /dev/null; $p^grep -c 0 /tmp/zig.gl
	$p^grep -v bind /tmp/zig.gl; $p^grep 'tail bind$' /tmp/zig.gl | wc -c
	$p^grep bind /tmp/zig.gn; $p^grep -v bind /tmp/zig.gn; $p^grep bind /tmp/zig.gn /dev/null
	$p^grep -c bind /tmp/zig.gn; $p^grep -n . /tmp/zig.gn; cat /tmp/zig.gn | $p^grep last
	$p^grep x /tmp/zig.ge; s; $p^grep -c x /tmp/zig.ge; $p^grep -L x /tmp/zig.ge; $p^grep -v x /tmp/zig.ge; s
	$p^grep -c '[^a]' /amd64/bin/rc; $p^grep -c '[^ab]' /amd64/bin/rc; $p^grep -c . /amd64/bin/rc
	$p^grep -c '^ELF|rc' /amd64/bin/rc; $p^grep -s '' /amd64/bin/rc; s
	$p^grep; s; $p^grep -q x $n; s; $p^grep '' $n; s; $p^grep -e '' $n; s; $p^grep -e; s
	$p^grep '(' $n; s; $p^grep ')' $n; s; $p^grep 'a)' $n; s; $p^grep '[abc' $n; s
	$p^grep 'a[bc' $n; s; $p^grep '*' $n; s; $p^grep '+a' $n; s; $p^grep 'a||b' $n; s
	$p^grep '()' $n; s; $p^grep 'a
)' $n; s; $p^grep -e a -e '|' $n; s; $p^grep x /nope; s; $p^grep x /nope $n; s
	$p^grep -f /nope x; s; $p^grep -f /tmp/zig.ge $n; s; $p^grep -e bind -e '' $n; s
	$p^grep -f /tmp/zig.gc -n $n; s
}

fn tests {
	p=$1
	$p^test -f /lib/namespace; s; $p^test -d /lib; s; $p^test -d /lib/namespace; s
	$p^test -e /nope; s; $p^test -r /lib/namespace; s; $p^test -w /dev/null; s
	$p^test -x /bin/rc; s; $p^test -x /lib/namespace; s; $p^test -s /dev/null; s
	$p^test -s /lib/namespace; s; $p^test -z ''; s; $p^test -n x; s
	$p^test a '=' a; s; $p^test a '!=' a; s; $p^test 3 -lt 10; s
	$p^test 010 -eq 8; s; $p^test 0x10 -eq 16; s; $p^test 99999999999 -eq 2147483647; s
	$p^test -5 -le -5; s; $p^test 7 -ge 8; s; $p^test 1 -gt 0 -a 2 -ne 2; s
	$p^test '!' -f /nope; s; $p^test '!' '!' x; s
	$p^test '(' -f /lib/namespace -a -d /lib ')' -o x '=' y; s
	$p^test -f /nope -o -d /lib; s; $p^test -A /lib/namespace; s; $p^test -L /lib; s
	$p^test /lib/namespace -nt /lib/ndb; s; $p^test /lib/namespace -ot /lib/ndb; s
	$p^test /lib/namespace -older 1h; s; $p^test /lib/namespace -older 100y; s
	$p^test /lib/namespace -older 3600; s
	$p^test -t 7; s; $p^test x; s; $p^test ''; s; $p^test -c x; s
	$p^test '('; s; $p^test -f; s; $p^test a b; s; $p^test a '=' b c; s
	$p^test /lib/namespace -older 1q; s; $p^test -t x; s; $p^test; s
}

# rc case $2 of rccases, run by the rc $1 in a directory of its own and
# an environment with only true, false (9front has no such programs) and
# $RC; pids, addresses and planZ's path are masked
fn rcrun {
	rm -rf /tmp/zig.rcd
	mkdir /tmp/zig.rcd
	@{
		rfork E
		cd /tmp/zig.rcd
		fn true { status='' }
		fn false { status=false }
		RC=$1
		$1 /tmp/zig.rcc/$2 </dev/null
		s
	} >[2=1] |
		sed 's;/tmp/zig/;;g
			s/ pid [0-9]+ cycle [0-9A-Fa-fx]+ ([0-9]+) [0-9A-Fa-fx]+( |$)/ pid PID cycle ADDR \1 ADDR\2/
			s/ pid [0-9]+ cycle [0-9A-Fa-fx]+ / pid PID cycle ADDR /
			s/([a-z]+) [0-9]+:/\1 PID:/g'
	rm -rf /tmp/zig.rcd
}

# mk, whose recipes and backquotes are rc: some of 9front's programs
# built with $1 as /bin/rc (planZ's rc or, given nothing, stock rc).
# Each is built in the same directory with either rc, since 6c records
# the source's path, and the output of mk and a sum of every file made
# are kept (of files only: a directory's sum holds its entries' times).
fn mks {
	@{
		rfork n
		if(! ~ $#* 0)
			bind $1 /bin/rc
		for(d in rc grep hoc awk mk){
			echo '=== '^$d
			rm -rf /tmp/zig.mk
			mkdir /tmp/zig.mk
			dircp /sys/src/cmd/$d /tmp/zig.mk
			@{
				cd /tmp/zig.mk
				mk >[2=1]; s
				for(f in `{ls})
					if(test -f $f)
						sha1sum $f
			}
		}
		rm -rf /tmp/zig.mk
	}
}

fn checks {
	nbad=()
	Z=$z/

	$Z^echo hello 'a b' -x >/tmp/zig.a; echo hello 'a b' -x >/tmp/zig.b; t echo1
	$Z^echo -n x y >/tmp/zig.a; echo -n x y >/tmp/zig.b; t echo2
	$Z^cat /lib/namespace /amd64/bin/rc >/tmp/zig.a; cat /lib/namespace /amd64/bin/rc >/tmp/zig.b; t cat1
	$Z^cat </lib/namespace >/tmp/zig.a; cat </lib/namespace >/tmp/zig.b; t cat2
	$Z^cat /nope >[2]/tmp/zig.a; cat /nope >[2]/tmp/zig.b; t cat3
	$Z^wc /lib/namespace /amd64/bin/rc >/tmp/zig.a; wc /lib/namespace /amd64/bin/rc >/tmp/zig.b; t wc1
	$Z^wc -lwrbc /amd64/bin/rc </lib/namespace >/tmp/zig.a; wc -lwrbc /amd64/bin/rc </lib/namespace >/tmp/zig.b; t wc2
	$Z^ls /dev /env/home /bin/ip /lib/namespace >/tmp/zig.a; ls /dev /env/home /bin/ip /lib/namespace >/tmp/zig.b; t ls1
	$Z^ls -F /amd64/bin >/tmp/zig.a; ls -F /amd64/bin >/tmp/zig.b; t ls2
	$Z^ls -ds /lib /amd64/bin/rc >/tmp/zig.a; ls -ds /lib /amd64/bin/rc >/tmp/zig.b; t ls3
	$Z^ls -tr /lib >/tmp/zig.a; ls -tr /lib >/tmp/zig.b; t ls4
	$Z^ls -pq /lib/ndb >/tmp/zig.a; ls -pq /lib/ndb >/tmp/zig.b; t ls5
	$Z^ls /nope >[2]/tmp/zig.a; ls /nope >[2]/tmp/zig.b; t ls6

	@{cd /lib/ndb; $Z^pwd} >/tmp/zig.a; @{cd /lib/ndb; pwd} >/tmp/zig.b; t pwd
	for(c in basename cleanname sleep uniq cmp tail){
		$c^s $Z >/tmp/zig.a >[2=1]
		$c^s '' >/tmp/zig.b >[2=1]
		t $c
	}

	# sysfatal and some usage messages print argv0, which is /tmp/zig/x
	# for planZ's programs: it is cut on both sides
	inputs
	for(c in mtime strings freq comm read unicode tr xd du test sed seq factor primes grep){
		$c^s $Z >[2=1] | sed 's;/tmp/zig/;;g' >/tmp/zig.a
		$c^s '' >[2=1] | sed 's;/tmp/zig/;;g' >/tmp/zig.b
		t $c
	}

	# g, the script, running each grep
	@{rfork n; bind $z/grep /bin/grep; g -i yyerror /sys/src/cmd/grep} >/tmp/zig.a >[2=1]
	g -i yyerror /sys/src/cmd/grep >/tmp/zig.b >[2=1]
	t g

	# Fixed from C, so these two are checked against what is right,
	# and stock's output is shown.  A pattern ending in \: the C reads
	# on past its 0 into the next argument, here '(', and fails with a
	# syntax error; the Zig's pattern ends there, as plain 'a' would.
	{$Z^grep 'a\' '('; s} >/tmp/zig.a >[2=1]
	{grep 'a' '('; s} >/tmp/zig.b >[2=1]
	t grep-backslash
	echo stock: `{grep 'a\' '(' >[2=1]; s}
	# grep's generation coming round (see tools/grepwrap.zig): the
	# last line of grepwrap.txt matches, as awk finds
	{$Z^grep -c -f $z/grepwrap.pat $z/grepwrap.txt; $Z^grep -n -f $z/grepwrap.pat $z/grepwrap.txt | tail -1} >/tmp/zig.a >[2=1]
	ab='[ab]'
	awk '/zz|a'^$ab^$ab^$ab^$ab^$ab^$ab^$ab^$ab^$ab^$ab^$ab^$ab^$ab^$ab^$ab^'/{n++; l=NR ": " $0} END{print n; print l}' $z/grepwrap.txt >/tmp/zig.b
	t grep-wrap
	echo stock: `{grep -c -f $z/grepwrap.pat $z/grepwrap.txt} `{grep -n -f $z/grepwrap.pat $z/grepwrap.txt | tail -1 | sed 's/:.*//'}
	# rc: each script of rccases run by planZ's rc and by stock rc
	rm -rf /tmp/zig.rcc
	mkdir /tmp/zig.rcc
	awk '/^#### /{if(f != "") close(f); f = "/tmp/zig.rcc/" $2; next} f != "" {print >f}' $z/rccases
	for(c in `{ls /tmp/zig.rcc | sed 's;.*/;;'}){
		rcrun $Z^rc $c >/tmp/zig.a
		rcrun rc $c >/tmp/zig.b
		t rc-$c
	}
	rm -rf /tmp/zig.rcc

	rm -rf /tmp/zig.utf /tmp/zig.c1 /tmp/zig.c2 /tmp/zig.x /tmp/zig.qd
	rm -f /tmp/zig.gl /tmp/zig.gn /tmp/zig.ge /tmp/zig.gp /tmp/zig.gx /tmp/zig.gc

	rm -rf /tmp/zig.zd /tmp/zig.sd
	mkdir /tmp/zig.zd /tmp/zig.sd
	@{cd /tmp/zig.zd; ops $Z} >/tmp/zig.a >[2=1]; tree /tmp/zig.zd >>/tmp/zig.a
	@{cd /tmp/zig.sd; ops ''} >/tmp/zig.b >[2=1]; tree /tmp/zig.sd >>/tmp/zig.b
	t files
	cat /tmp/zig.zd/log /tmp/zig.zd/x/log /tmp/zig.zd/tee.out >/tmp/zig.a
	cat /tmp/zig.sd/log /tmp/zig.sd/x/log /tmp/zig.sd/tee.out >/tmp/zig.b
	t tee
	rm -rf /tmp/zig.a /tmp/zig.b /tmp/zig.u /tmp/zig.zd /tmp/zig.sd

	# libregexp: the Zig port against the stock library, which
	# retest.c is built with here (see tools/retest.c)
	if(@{cd $z && 6c -FTVw retest.c && 6l -o retest.stock retest.6} >/tmp/zig.cc >[2=1]){
		$Z^retest $z/retest.txt >/tmp/zig.a >[2=1]
		$z/retest.stock $z/retest.txt >/tmp/zig.b >[2=1]
		t regexp
	}
	if not {
		echo DIFF regexp: retest.c did not build
		cat /tmp/zig.cc
		nbad=($nbad regexp)
	}
	rm -f /tmp/zig.cc

	# %e %f %g and strtod: the Zig port against stock libc, which
	# fltest.c is built with here (see tools/fltest.c)
	if(@{cd $z && 6c -FTVw fltest.c && 6l -o fltest.stock fltest.6} >/tmp/zig.cc >[2=1]){
		$Z^fltest >/tmp/zig.a >[2=1]
		$z/fltest.stock >/tmp/zig.b >[2=1]
		t float
	}
	if not {
		echo DIFF float: fltest.c did not build
		cat /tmp/zig.cc
		nbad=($nbad float)
	}
	rm -f /tmp/zig.cc

	mks $z/rc >/tmp/zig.a >[2=1]
	mks >/tmp/zig.b >[2=1]
	t mk
	rm -f /tmp/zig.a /tmp/zig.b

	# the kernel keeps each process's registers across context switches:
	# eight fpstress, more than the processors, with forks and execs
	# beside them (see src/user/cmd/fpstress.zig)
	{
		{for(i in `{seq 200}) echo x | cat >/dev/null} &
		for(i in 1 2 3 4 5 6 7 8) $Z^fpstress 40 &
		wait
	} >/tmp/zig.fp >[2=1]
	if(grep -s ' bad [1-9]' /tmp/zig.fp || ! ~ `{grep -c ' bad 0$' /tmp/zig.fp} 8){
		echo DIFF fpstress
		cat /tmp/zig.fp
		nbad=($nbad fpstress)
	}
	if not
		echo same fpstress: registers kept
	rm -f /tmp/zig.fp

	if(! $Z^libctest)
		nbad=($nbad libctest)
	if(~ $#nbad 0)
		echo 'zig: all the same as stock, libctest ok'
	if not
		echo 'zig: failed:' $nbad
}

checks >[2=1] | tee /tmp/zig.txt
echo 'the programs are in' $z
