#!/bin/rc
# With zig build -Dzigboot the loader puts this in the kernel's /boot.
# It says whether the programs that option replaces are the ones
# running: every process named init, mntgen or kbdfs must have the
# text of the file of that name in /boot, and there must be one at
# least; and every process named usbd, kb or disk (the USB programs,
# which a machine without USB does not run) that of /boot/usbd,
# /boot/usbkb or /boot/usbdisk.  The boot tests run it, so that a boot
# which fell back to the stock programs does not pass.
bad=()
usb=()
fn chk {
	c=0
	for(p in `{ps | awk '$NF == "'$1'" {print $2}'}){
		if(cmp -s /proc/$p/text /boot/$2)
			c=`{echo $c + 1 | hoc}
		if not
			bad=($bad $1)
	}
	if(~ $c 0 && ~ $3 must)
		bad=($bad $1)
	if(~ $3 may)
		usb=($usb $1 $c)
}
chk init init must
chk mntgen mntgen must
chk kbdfs kbdfs must
chk usbd usbd may
chk kb usbkb may
chk disk usbdisk may
if(~ $#bad 0){
	echo zigboot: init, mntgen and kbdfs are the files in /boot, and the processes of $usb
	exit ''
}
echo zigboot: not the files in /boot: $bad
exit bad
